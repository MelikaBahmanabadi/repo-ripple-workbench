# Public Supabase project configuration
# Copy to .env for local development and fill in values from your Supabase project.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Vite-exposed values are public by design; never put service-role keys here.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
